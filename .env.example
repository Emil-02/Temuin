# Salin file ini menjadi .env.local lalu isi nilainya.
# JANGAN commit .env.local ke git.

# ---- Supabase (Dashboard -> Project Settings -> API) ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service role key: RAHASIA, hanya dipakai server-side
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---- AI utama: Ollama (server AI kampus) ----
# Dipakai untuk isi otomatis dari foto, ekstraksi atribut, embedding, dan
# penilaian verifikasi. Kosongkan OLLAMA_BASE_URL untuk menonaktifkan.
OLLAMA_BASE_URL=https://ollama.if.unismuh.ac.id
OLLAMA_MODEL=gemma4:latest
OLLAMA_EMBED_MODEL=bge-m3:latest
# Lama model ditahan di memori server setelah dipakai (hindari cold start)
OLLAMA_KEEP_ALIVE=30m
# Opsional, bila server Ollama memakai autentikasi Bearer
OLLAMA_API_KEY=

# ---- AI cadangan: Gemini (https://aistudio.google.com/apikey) ----
# Dipakai otomatis bila server Ollama gagal/timeout. Opsional.
# RAHASIA: hanya dipakai server-side, tidak pernah dikirim ke browser
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ---- Seed data demo (bebas, string acak) ----
SEED_SECRET=temuin-demo-2026
